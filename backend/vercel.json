{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, POST, OPTIONS, PUT, DELETE, PATCH" },
        { "key": "Access-Control-Allow-Headers", "value": "Range, Content-Type, Authorization, X-Requested-With, Origin, Accept, User-Agent, X-Referer, X-Origin" },
        { "key": "Access-Control-Expose-Headers", "value": "Content-Range, Content-Length, Accept-Ranges, Content-Type, Content-Disposition" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
